<div class="ma-targetmap">
  <p class="ma-target-prompt">{{localize "MONSTER_ANATOMY.Target.Hint"}} <strong>{{actorName}}</strong></p>
  <div class="ma-partgrid" data-parts>
    {{#each parts}}
    <button type="button" class="ma-partcard ma-state-{{state}}" data-part-id="{{id}}">
      <span class="ma-partcard-thumb">
        {{#if img}}<img src="{{img}}" alt="" />{{else}}<i class="fa-solid fa-crosshairs"></i>{{/if}}
      </span>
      <span class="ma-partcard-body">
        <span class="ma-partcard-name">{{name}}</span>
        <span class="ma-hpbar" role="progressbar" aria-valuenow="{{hpValue}}" aria-valuemin="0" aria-valuemax="{{hpMax}}">
          <span class="ma-hpfill" style="width: {{hpPct}}%;"></span>
        </span>
        <span class="ma-partcard-meta">
          <span class="ma-badge">{{stateLabel}}</span>
          <span class="ma-ac" title="{{localize "MONSTER_ANATOMY.Panel.AcLabel"}}"><i class="fa-solid fa-shield-halved"></i> {{acDisplay}}</span>
        </span>
      </span>
    </button>
    {{/each}}
  </div>
  <button type="button" class="ma-normal-attack" data-normal>
    <i class="fa-solid fa-hand-fist"></i> {{localize "MONSTER_ANATOMY.Target.Normal"}}
  </button>
  {{#if canAdd}}
  <details class="ma-quickadd">
    <summary>{{localize "MONSTER_ANATOMY.Target.QuickAdd"}}</summary>
    <div class="ma-row ma-qarow">
      <img class="ma-imgpreview" data-qa="preview" src="" alt="" hidden />
      <input data-qa="name" type="text" maxlength="80" placeholder="{{localize "MONSTER_ANATOMY.Editor.Name"}}" />
      <input data-qa="img" type="text" placeholder="{{localize "MONSTER_ANATOMY.Editor.Image"}}" />
      <button type="button" data-qa-browse title="{{localize "MONSTER_ANATOMY.Editor.Browse"}}">
        <i class="fa-solid fa-folder-open"></i>
      </button>
      <button type="button" data-qa-add title="{{localize "MONSTER_ANATOMY.Target.QuickAdd"}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    </div>
  </details>
  {{/if}}
</div>
