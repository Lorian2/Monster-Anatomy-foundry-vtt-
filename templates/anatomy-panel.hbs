<div class="ma-panel">
<div class="ma-header">
  <img class="ma-actor-img" src="{{actorImg}}" alt="{{actorName}}" />
  <div class="ma-header-text">
    <h2 class="ma-actor-name">{{actorName}}</h2>
    {{#if phase}}<span class="ma-phase" title="{{phase}}">🔥 {{phase}}</span>{{/if}}
  </div>
  <div class="ma-header-actions">
    {{#if canEdit}}
    <button type="button" class="ma-add" data-action="add-part">
      <i class="fa-solid fa-plus"></i>
      <span>{{localize "MONSTER_ANATOMY.Panel.AddPart"}}</span>
    </button>
    {{/if}}
    <button type="button" class="ma-icon-btn" data-action="open-tracker" title="{{localize "MONSTER_ANATOMY.Panel.OpenTracker"}}">
      <i class="fa-solid fa-heart-pulse"></i>
    </button>
    <button type="button" class="ma-icon-btn" data-action="open-summary" title="{{localize "MONSTER_ANATOMY.Panel.OpenSummary"}}">
      <i class="fa-solid fa-scroll"></i>
    </button>
  </div>
</div>

{{#if canEdit}}
<details class="ma-tools">
  <summary><i class="fa-solid fa-screwdriver-wrench"></i> {{localize "MONSTER_ANATOMY.Panel.GmTools"}}</summary>
  <div class="ma-templates">
    <select class="ma-template-select" title="{{localize "MONSTER_ANATOMY.Panel.ApplyTemplate"}}">
      {{#each templates}}
      <option value="{{id}}">{{name}}</option>
      {{/each}}
    </select>
    <button type="button" data-action="apply-template" title="{{localize "MONSTER_ANATOMY.Panel.ApplyTemplate"}}">
      <i class="fa-solid fa-download"></i>
    </button>
    {{#if isGM}}
    <button type="button" data-action="save-template" title="{{localize "MONSTER_ANATOMY.Panel.SaveTemplate"}}">
      <i class="fa-solid fa-floppy-disk"></i>
    </button>
    <button type="button" data-action="delete-template" title="{{localize "MONSTER_ANATOMY.Panel.DeleteTemplate"}}">
      <i class="fa-solid fa-trash-can"></i>
    </button>
    <button type="button" class="{{#if hideAc}}is-on{{/if}}" data-action="toggle-hide-ac" title="{{#if hideAc}}{{localize "MONSTER_ANATOMY.Panel.ShowAc"}}{{else}}{{localize "MONSTER_ANATOMY.Panel.HideAc"}}{{/if}}">
      <i class="fa-solid {{#if hideAc}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
    </button>
    {{/if}}
  </div>
</details>
{{/if}}

{{#if empty}}
{{#if canEdit}}
<div class="ma-empty-cta">
  <p class="ma-empty-title">{{localize "MONSTER_ANATOMY.Panel.GenerateTitle"}}</p>
  <p class="ma-empty-hint">{{localize "MONSTER_ANATOMY.Panel.GenerateHint"}}</p>
  <div class="ma-templates">
    <select class="ma-template-select">
      {{#each templates}}
      <option value="{{id}}">{{name}}</option>
      {{/each}}
    </select>
    <button type="button" class="ma-add" data-action="apply-template">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>{{localize "MONSTER_ANATOMY.Panel.Generate"}}</span>
    </button>
  </div>
  <p class="ma-empty-hint">{{localize "MONSTER_ANATOMY.Panel.GenerateOr"}}</p>
</div>
{{else}}
<p class="ma-empty">{{localize "MONSTER_ANATOMY.Panel.Empty"}}</p>
{{/if}}
{{else}}
<ul class="ma-parts">
  {{#each parts}}
  <li class="ma-part ma-state-{{state}}" data-part-id="{{id}}">
    <div class="ma-part-top">
      <span class="ma-part-thumb">
        {{#if img}}<img src="{{img}}" alt="" />{{else}}<i class="fa-solid fa-paw"></i>{{/if}}
      </span>
      <div class="ma-part-main">
        <div class="ma-part-line">
          <span class="ma-part-name" {{#if ../isGM}}title="{{localize "MONSTER_ANATOMY.Panel.IdLabel"}}: {{id}}"{{/if}}>{{name}}</span>
          <span class="ma-badge" title="{{stateLabel}}">
            {{stateLabel}}{{#if hpMismatch}} <i class="fa-solid fa-triangle-exclamation" title="{{localize "MONSTER_ANATOMY.Panel.StateMismatch"}}"></i>{{/if}}
          </span>
          <span class="ma-ac" title="{{localize "MONSTER_ANATOMY.Panel.AcLabel"}}">
            <i class="fa-solid fa-shield-halved"></i> {{acDisplay}}
          </span>
        </div>
        <div class="ma-part-stats">
          <div class="ma-hpbar" role="progressbar" aria-valuenow="{{hp.value}}" aria-valuemin="0" aria-valuemax="{{hp.max}}" title="{{hp.value}} / {{hp.max}}">
            <div class="ma-hpfill" style="width: {{hpPct}}%;"></div>
          </div>
          <span class="ma-hptext">{{hp.value}} / {{hp.max}}</span>
        </div>
        {{#if severable}}
        <div class="ma-part-stats ma-sever" title="{{localize "MONSTER_ANATOMY.Panel.SeverLabel"}}">
          <div class="ma-hpbar ma-severbar" role="progressbar" aria-valuenow="{{sever.value}}" aria-valuemin="0" aria-valuemax="{{sever.max}}" title="{{sever.value}} / {{sever.max}}">
            <div class="ma-hpfill" style="width: {{severPct}}%;"></div>
          </div>
          <span class="ma-hptext">🗡️ {{sever.value}} / {{sever.max}}</span>
        </div>
        {{/if}}
        {{#if linkedItemName}}
        <div class="ma-linked{{#if linkedDisabled}} is-disabled{{/if}}" title="{{linkedItemName}}">
          🔗 {{linkedItemName}}{{#if linkedDisabled}} — {{localize "MONSTER_ANATOMY.Panel.Disabled"}}{{/if}}
        </div>
        {{/if}}
      </div>
    </div>
    {{#if ../canEdit}}
    <div class="ma-part-actions">
      <span class="ma-quick">
        <input class="ma-amount" type="number" min="1" step="1" value="10" title="{{localize "MONSTER_ANATOMY.Panel.Amount"}}" />
        <button type="button" data-action="damage-part" data-part-id="{{id}}" title="{{localize "MONSTER_ANATOMY.Panel.Damage"}}">
          <i class="fa-solid fa-heart-crack"></i>
        </button>
        <button type="button" data-action="heal-part" data-part-id="{{id}}" title="{{localize "MONSTER_ANATOMY.Panel.Heal"}}">
          <i class="fa-solid fa-heart-pulse"></i>
        </button>
      </span>
      <span class="ma-part-tools">
        <button type="button" data-action="edit-part" data-part-id="{{id}}" title="{{localize "MONSTER_ANATOMY.Panel.Edit"}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" data-action="duplicate-part" data-part-id="{{id}}" title="{{localize "MONSTER_ANATOMY.Panel.Duplicate"}}">
          <i class="fa-solid fa-copy"></i>
        </button>
        <button type="button" data-action="delete-part" data-part-id="{{id}}" title="{{localize "MONSTER_ANATOMY.Panel.Delete"}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </span>
    </div>
    {{/if}}
  </li>
  {{/each}}
</ul>
{{/if}}
</div>
