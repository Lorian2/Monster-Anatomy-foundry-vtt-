{
  "name": "monster-anatomy",
  "version": "1.0.0",
  "description": "Sistema de anatomia e partes destrutíveis para Foundry VTT v13+",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "link": "node scripts/link-dist.mjs",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:bundle": "node scripts/bundle-check.mjs",
    "check": "npm run typecheck && npm run check:i18n && npm run build && npm run check:bundle"
  },
  "devDependencies": {
    "fvtt-types": "npm:@league-of-foundry-developers/foundry-vtt-types@^13.345.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.3.0"
  }
}
